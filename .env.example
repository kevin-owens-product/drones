# Copy to .env before docker compose up. These values are for a laptop only.
# Production refuses the data key below, test auth, and dev login.

POSTGRES_USER=a2e
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=a2e
A2E_APP_DB_PASSWORD=change-me-app

A2E_ENV=development
A2E_AUTH_MODE=oidc
A2E_DEV_LOGIN=0
A2E_DEV_LOGIN_PASSWORD=dev-only-change-me
A2E_SEED=1
A2E_SYSTEM_HIGH=CUI
A2E_SESSION_SECRET=dev-only-session-secret-change-me
# 32 bytes: 0123456789abcdef0123456789abcdef — refused when A2E_ENV=production
A2E_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
A2E_RATE_LIMIT_ENABLED=1
A2E_COOKIE_SECURE=0
A2E_OTEL_ENABLED=1
A2E_OTEL_ENDPOINT=http://otel-collector:4317
A2E_OPA_URL=http://opa:8181
A2E_POLICY_DIR=/app/policies
A2E_DATABASE_URL=postgresql+asyncpg://a2e_app:change-me-app@postgres:5432/a2e
A2E_MIGRATION_DATABASE_URL=postgresql+psycopg://a2e:change-me-db@postgres:5432/a2e
A2E_REDIS_URL=redis://:change-me-redis@redis:6379/0
A2E_OIDC_ISSUER=http://localhost:8080/realms/a2e-dev
A2E_OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/a2e-dev
A2E_OIDC_JWKS_URL=http://keycloak:8080/realms/a2e-dev/protocol/openid-connect/certs
A2E_OIDC_AUDIENCE=a2e-api
A2E_OIDC_PUBLIC_CLIENT_ID=a2e-ui
A2E_OIDC_REDIRECT_URI=http://localhost:8000/v1/session/callback
A2E_UI_ORIGIN=http://localhost:8000

REDIS_PASSWORD=change-me-redis
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
MINIO_ROOT_USER=a2e-minio
MINIO_ROOT_PASSWORD=change-me-minio
GRAFANA_ADMIN_PASSWORD=change-me-grafana
